{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "X-Spider",
    "version": "../package.json"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "app": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "dialog": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "os": {
        "all": true
      },
      "path": {
        "all": true
      },
      "shell": {
        "all": true,
        "open": ".*",
        "scope": [
          {
            "name": "explorer",
            "cmd": "explorer",
            "args": true
          },
          {
            "name": "binaries/aria2c",
            "sidecar": true,
            "args": true
          }
        ]
      },
      "window": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      // ✅ 修正：在 Tauri v1 中，Asset Protocol 配置在 allowlist.protocol 下
      "protocol": {
        "asset": true,
        "assetScope": ["**"]
      }
    },
    "bundle": {
      "active": true,
      "targets": [
        "nsis"
      ],
      "identifier": "x-spider",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "externalBin": [
        "binaries/aria2c"
      ]
    },
    "security": {
      // ✅ 修正：在 CSP 中允许 asset 协议和 asset.localhost
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:;"
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "X-Spider",
        "width": 1280,
        "height": 920,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true
      }
    ]
  }
}